# Ignore CMake build directory and generated files
/build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Ignore compiled binaries and object files
*.o
*.obj
*.so
*.a
*.lib
*.dll
*.dylib
*.exe
*.out
*.app

# Ignore test binaries and logs
/tests/
Testing/
CTestTestfile.cmake

# Ignore compiler-generated dependency files
*.d

# Ignore Precompiled Headers
*.gch
*.pch

# Ignore Fortran module files
*.mod
*.smod

# Ignore compiled static and dynamic libraries
*.lai
*.la

# Ignore any editor or OS-generated files (optional)
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Python specific
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# pybind11 specific
_deps/
_build/
_skbuild/
_cmake_test_compile/
*.cpython-*-darwin.so
*.cpython-*-linux.so
*.cpython-*-win32.so
*.cpython-*-win_amd64.so

